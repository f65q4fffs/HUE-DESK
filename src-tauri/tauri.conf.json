{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HueDesk",
  "version": "0.1.0",
  "identifier": "com.huelight.controller",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HueDesk",
        "label": "main",
        "width": 860,
        "height": 590,
        "minWidth": 420,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
